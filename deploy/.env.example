# Copy to deploy/.env (git-ignored by the .env rule) or export in your shell.
# NO SECRETS: AWS credentials come only from the AWS CLI profile (aws configure sso --profile loopcheck),
# never from this file, the repository, or chat.

# Streamlit UI "HTTP API" mode. After deployment: the stack output ApiUrl. Local stand-in: http://127.0.0.1:8000
LOOPCHECK_API_URL=https://<api-id>.execute-api.ap-south-1.amazonaws.com

# Deployment / preflight (deploy/preflight.sh reads the LOOPCHECK_* names)
LOOPCHECK_AWS_PROFILE=loopcheck
LOOPCHECK_AWS_REGION=ap-south-1
STACK=loopcheck-demo
ALLOWED_ORIGIN=http://localhost:8501
