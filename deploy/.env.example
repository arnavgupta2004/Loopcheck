# Copy to deploy/.env (git-ignored via .env rules) or export in your shell. No secrets here:
# AWS credentials come from your normal AWS credential chain (aws configure / SSO / env),
# never from this file and never from the repository.

# Streamlit UI: HTTP API mode default URL. Local stand-in: http://127.0.0.1:8000
LOOPCHECK_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com

# Deployment (used by the commands in docs/d4_demo_and_deployment.md)
AWS_REGION=<region, e.g. eu-west-1>
STACK_NAME=loopcheck-demo
ALLOWED_ORIGIN=http://localhost:8501
